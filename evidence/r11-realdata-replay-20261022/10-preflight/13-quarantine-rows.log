=== quarantine schema diff-relevant ===
CREATE TABLE asset_value_snapshots (
  id TEXT PRIMARY KEY,
  asset_id TEXT NOT NULL REFERENCES assets(id) ON DELETE RESTRICT,
  as_of_date TEXT NOT NULL,
  value TEXT NOT NULL,
  created_at TEXT NOT NULL,
  UNIQUE(asset_id, as_of_date)
)
CREATE TABLE assets (
  id TEXT PRIMARY KEY,
  profile_id TEXT NOT NULL REFERENCES profiles(id) ON DELETE RESTRICT,
  name TEXT NOT NULL,
  kind TEXT NOT NULL CHECK (kind IN ('LIQUID_INVESTMENT','OTHER')),
  include_in_safety_resources INTEGER NOT NULL CHECK (include_in_safety_resources IN (0,1)),
  active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0,1)),
  created_at TEXT NOT NULL
)
CREATE TABLE cash_account_lifecycle_revisions (
  revision_id INTEGER PRIMARY KEY AUTOINCREMENT,
  account_id TEXT NOT NULL REFERENCES cash_accounts(id) ON DELETE RESTRICT,
  as_of_date TEXT NOT NULL,
  active INTEGER NOT NULL CHECK (active IN (0,1)),
  created_at TEXT NOT NULL
)
CREATE TABLE cash_accounts (
  id TEXT PRIMARY KEY,
  profile_id TEXT NOT NULL REFERENCES profiles(id) ON DELETE RESTRICT,
  name TEXT NOT NULL,
  include_in_safety_resources INTEGER NOT NULL CHECK (include_in_safety_resources IN (0,1)),
  active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0,1)),
  created_at TEXT NOT NULL
, reserved_amount TEXT NOT NULL DEFAULT '0.00')
CREATE TABLE cash_balance_snapshots (
  id TEXT PRIMARY KEY,
  account_id TEXT NOT NULL REFERENCES cash_accounts(id) ON DELETE RESTRICT,
  as_of_date TEXT NOT NULL,
  balance TEXT NOT NULL,
  created_at TEXT NOT NULL,
  UNIQUE(account_id, as_of_date)
)
CREATE TABLE fixed_expense_plans (
  id TEXT PRIMARY KEY,
  profile_id TEXT NOT NULL REFERENCES profiles(id) ON DELETE RESTRICT,
  name TEXT NOT NULL,
  monthly_amount TEXT NOT NULL,
  effective_from TEXT NOT NULL,
  note TEXT,
  active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0,1)),
  created_at TEXT NOT NULL
)
CREATE TABLE income_entries (
  id TEXT PRIMARY KEY,
  profile_id TEXT NOT NULL REFERENCES profiles(id) ON DELETE RESTRICT,
  period_month TEXT NOT NULL CHECK (
    length(period_month)=7 AND substr(period_month,5,1)='-'
    AND substr(period_month,6,2) BETWEEN '01' AND '12'
    AND substr(period_month,1,4) NOT GLOB '*[^0-9]*'
  ),
  occurred_at TEXT NOT NULL,
  amount TEXT NOT NULL,
  label TEXT NOT NULL DEFAULT '',
  one_time INTEGER NOT NULL DEFAULT 0 CHECK (one_time IN (0,1)),
  created_at TEXT NOT NULL,
  UNIQUE(profile_id, occurred_at, label, amount)
)
CREATE TABLE profiles (
  id TEXT PRIMARY KEY,
  singleton_id INTEGER NOT NULL DEFAULT 1 UNIQUE CHECK (singleton_id = 1),
  display_name TEXT,
  created_at TEXT NOT NULL
)
