{
  "name": "personal-finance-console",
  "version": "0.1.0",
  "description": "Pure TypeScript financial model core for Personal Finance Console",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "type": "module",
  "scripts": {
    "lint": "biome check src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:product": "vitest run tests",
    "test:wp03-preview": "python3 -m unittest discover -s scripts -p test_wp03_preview_packaging.py -v",
    "test:release-gate": "python3 -m unittest scripts/test_production_v4_release_gate.py -v",
    "build": "npm run build:core && npm run build:web",
    "build:core": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "vite --host 127.0.0.1",
    "tauri:dev": "tauri dev --config src-tauri/tauri.smoke.conf.json",
    "tauri:dev:smoke": "tauri dev --config src-tauri/tauri.smoke.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.smoke.conf.json",
    "tauri:build:smoke": "tauri build --config src-tauri/tauri.smoke.conf.json",
    "tauri:dev:production": "tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build:production": "tauri build --config src-tauri/tauri.conf.json",
    "build:v4acceptance": "vite build --config vite.v4acceptance.config.ts",
    "tauri:build:v4acceptance": "CARGO_TARGET_DIR=\"$(pwd)/artifacts/v012-v4-owner-acceptance-sandbox-20261007/cargo-target\" tauri build --features tauri/custom-protocol,v4-acceptance --config src-tauri/tauri.v4acceptance.conf.json",
    "tauri:build:wp03-preview": "python3 scripts/build_wp03_product_preview.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  }
}
